# Assim como o Traefik, o Portainer sobe pelo bootstrap e nao por uma stack do
# proprio Portainer. Valores reais entram na linha de comando do bootstrap.
PORTAINER_HOST=portainer.seudominio.com
PORTAINER_IMAGE=portainer/portainer-ce:lts
PORTAINER_AGENT_IMAGE=portainer/agent:lts
NETWORK_PUBLIC=network_public
