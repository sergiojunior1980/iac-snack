# Valores reais ficam nas variaveis da stack no Portainer.
# Segredos permanecem em branco aqui de proposito.

# A imagem NAO e variavel: fica fixa no stack.yml e o CD reescreve aquela linha
# a cada deploy. Rollback e `git revert` do commit de deploy correspondente.
APP_HOST=snack.seudominio.com

# Opcionais.
APP_REPLICAS=1
APP_CPU_LIMIT=1.00
APP_MEMORY_LIMIT=1G

NETWORK_PUBLIC=network_public
